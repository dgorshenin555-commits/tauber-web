---
// ── Источники и шаблоны каталога ──────────────────────────────────
// АФТ используют вкладки; остальные товары сохраняют общий шаблон.
import Base from '../../layouts/Base.astro';
import StranicaKategorii from '../../components/StranicaKategorii.astro';
import StranicaTovara from '../../components/StranicaTovara.astro';
import StranicaAft from '../../components/StranicaAft.astro';
import { sayt } from '../../lib/content.js';
import { put } from '../../lib/put.js';

const kategoriiFayly = import.meta.glob('../../../content/catalog/*.json', { eager: true });
const tovaryFayly = import.meta.glob('../../../content/tovary/*.json', { eager: true });

// ── Статические адреса из отдельных JSON ───────────────────────────
export async function getStaticPaths() {
  const { kategorii } = await import('../../lib/content.js');
  const tovary = Object.keys(import.meta.glob('../../../content/tovary/*.json'))
    .map((p) => p.split('/').pop().replace('.json', ''));
  return [
    ...kategorii.map((k) => ({ params: { klyuch: k.klyuch }, props: { vid: 'kategoriya' } })),
    ...tovary.map((k) => ({ params: { klyuch: k }, props: { vid: 'tovar' } })),
  ];
}

// ── Выбор содержания и метаданных текущей страницы ─────────────────
const { klyuch } = Astro.params;
const { vid } = Astro.props;

const nayti = (fayly) => {
  const z = Object.entries(fayly).find(([p]) => p.endsWith(`/${klyuch}.json`));
  return z ? (z[1].default ?? z[1]) : null;
};

const d = vid === 'tovar' ? nayti(tovaryFayly) : nayti(kategoriiFayly);
if (!d) throw new Error(`Нет содержания для ${klyuch}`);

const zagolovok = vid === 'tovar' ? d.zagolovok : d.hlebnaya_kroshka;
const opisanie = vid === 'tovar' ? d.vvodnyy_tekst : d.vvodnyy_tekst?.[0];
---

<!-- ── Хлебные крошки и выбор представления ─────────────────────── -->
<Base title={`${zagolovok} — ${sayt.nazvanie}`} description={opisanie}>
  <nav class="kroshki" aria-label="Вы здесь">
    <a href={put('/')}>Главная</a>
    <span class="ms">chevron_right</span>
    <span class="kroshki__tekushchaya">{zagolovok}</span>
  </nav>

  {vid === 'tovar' ? (d.aft ? <StranicaAft d={d} /> : <StranicaTovara d={d} klyuch={klyuch} />) : <StranicaKategorii d={d} />}
</Base>

<style>
  /* ── Компактная навигация по пути страницы ────────────────────── */
  .kroshki {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    padding: 18px var(--pole-bok) 0;
    font-size: 13px;
    color: var(--tekst-tihiy);
  }

  .kroshki a { color: var(--tekst-tihiy); }
  .kroshki a:hover { color: var(--navedenie); }
  .kroshki .ms { font-size: 16px; }
  .kroshki__tekushchaya { color: var(--tekst); }
</style>
