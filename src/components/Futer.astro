---
import { put } from '../lib/put.js';
import { sayt, kategorii, futer } from '../lib/content.js';

const kategoriiFutera = futer.kategorii.map((key) => kategorii.find((k) => k.klyuch === key)).filter(Boolean);
const telefonSsylka = `tel:${sayt.telefon.replace(/[^\d+]/g, '')}`;
const god = new Date().getFullYear();

---

<footer class="futer">
  <div class="futer__kolonki">
    <div class="futer__kolonka futer__kolonka--pervaya">
      <a class="futer__znak" data-logotip-futer href={put('/')}>
        {sayt.logotip
          ? <img src={put(sayt.logotip)} alt={sayt.nazvanie} />
          : sayt.nazvanie}
      </a>
      <p class="futer__opisanie">{futer.opisanie}</p>
    </div>

    <div class="futer__kolonka">
      <div class="futer__zagolovok">Продукция</div>
      {kategoriiFutera.map((k) => (
        <a class="futer__ssylka" href={put(`/catalog/${k.klyuch}/`)}>{k.korotko}</a>
      ))}
    </div>

    <div class="futer__kolonka">
      <div class="futer__zagolovok">Компания</div>
      {futer.razdely.map((r) => (
        <a class="futer__ssylka" href={put(r.adres)}>{r.podpis}</a>
      ))}
    </div>

    <div class="futer__kolonka">
      <div class="futer__zagolovok">Контакты</div>
      <a class="futer__ssylka futer__kontakt" href={telefonSsylka}>{sayt.telefon}</a>
      <a class="futer__ssylka" href={`mailto:${sayt.pochta}`}>{sayt.pochta}</a>
      <a class="futer__zayavka" href={`mailto:${sayt.pochta}?subject=${encodeURIComponent('Заявка с сайта')}`}>
        {futer.knopka_zayavki} <span class="ms">arrow_forward</span>
      </a>
    </div>
  </div>

  <div class="futer__niz">
    <span>© {god} {sayt.nazvanie}. Все права защищены.</span>
    <a class="futer__politika" data-politika href={put(futer.politika.adres)}>{futer.politika.podpis}</a>
  </div>
</footer>

<style>
  .futer {
    background: var(--futer);
    color: var(--futer-tekst);
    padding: 40px var(--pole-bok) 26px;
  }

  .futer__kolonki { display: flex; gap: 64px; flex-wrap: wrap; }
  .futer__kolonka--pervaya { flex: 1 1 260px; max-width: 360px; }
  .futer__znak {
    display: inline-block;
    font-size: 24px;
    font-weight: 300;
    letter-spacing: .04em;
    color: #fff;
  }

  /* В новом эталоне светлый футер и исходный цвет логотипа. */
  .futer__znak img { height: 54px; width: auto; display: block;  }
  .futer__opisanie { margin: 14px 0 0; font-size: 14px; line-height: 1.55; color: #77716b; }
  .futer__kolonka { display: flex; flex-direction: column; gap: 10px; min-width: 200px; }

  .futer__zagolovok {
    font-size: 12.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: #77716b;
    margin-bottom: 6px;
  }

  .futer__ssylka { color: var(--futer-tekst); font-size: 15px; }
  .futer__ssylka:hover { color: #fff; }
  .futer__ssylka--net { color: #77716b; cursor: default; }
  .futer__kontakt { font-size: 19px; font-weight: 400; color: #fff; }

  .futer__politika { color: #77716b; }
  .futer__politika:hover { color: #fff; }

  .futer__zayavka {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    margin-top: 12px;
    padding: 13px 22px;
    background: transparent;
    border: 1px solid rgba(255, 255, 255, .25);
    color: #fff;
    border-radius: var(--radius-pilyulya);
    font-size: 15px;
    align-self: flex-start;
  }

  .futer__zayavka { color: #fff; }
  .futer__zayavka:hover { color: #fff; background: rgba(255, 255, 255, .08); }
  .futer__zayavka .ms { font-size: 18px; }

  .futer__niz {
    display: flex;
    justify-content: space-between;
    gap: 20px;
    flex-wrap: wrap;
    margin-top: 40px;
    padding-top: 20px;
    border-top: 1px solid rgba(255, 255, 255, .1);
    font-size: 13px;
    color: #77716b;
  }

  @media (max-width: 1024px) { .futer__kolonki { gap: 40px; } }
  @media (max-width: 768px) {
    .futer__kolonki { flex-direction: column; gap: 28px; }
    .futer__niz { flex-direction: column; gap: 8px; }
  }
  @media (max-width: 480px) { .futer { padding-top: 30px; } }

  .futer { border-top: 1px solid #dedad1; margin-top: 30px; }
  .futer__kolonki { display: grid; grid-template-columns: 1.4fr 1fr 1fr 1fr; gap: 36px; }
  .futer__kolonka { min-width: 0; }
  .futer__znak img { max-width: 100%; height: auto; width: 230px; }
  .futer__kontakt { color: var(--tekst); font-size: 18px; }
  .futer__ssylka:hover, .futer__politika:hover { color: var(--tekst); text-decoration: underline; }
  .futer__zayavka { color: #fff; background: var(--tekst); border: 0; }
  .futer__zayavka:hover { color: #fff; background: var(--tekst); opacity: .9; }
  .futer__niz { border-top-color: #dedad1; }
  @media (max-width: 1024px) { .futer__kolonki { grid-template-columns: 1fr 1fr; gap: 32px; } }
  @media (max-width: 480px) { .futer__kolonki { grid-template-columns: 1fr; } }
</style>
