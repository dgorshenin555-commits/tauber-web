---
import { sayt } from '../lib/content.js';
import { put } from '../lib/put.js';

interface Props {
  d: any;
  klyuch: string;
}

const { d, klyuch } = Astro.props;
const zayavka = `mailto:${sayt.pochta}?subject=${encodeURIComponent(`Запрос: ${d.zagolovok}`)}`;
---

<section class="tovar-verh">
  <div class="tovar-verh__tekst">
    <h1 class="tovar-verh__zagolovok">{d.zagolovok}</h1>
    {d.vvodnyy_tekst && <p class="tovar-verh__lead">{d.vvodnyy_tekst}</p>}
    <a class="tovar-verh__knopka" href={zayavka}>Запросить документацию <span class="ms">arrow_forward</span></a>
  </div>

  {d.kartinka && (
    <div class="tovar-verh__kartinka">
      <img src={put(d.kartinka)} alt={d.zagolovok} />
    </div>
  )}
</section>

{d.fakty.length > 0 && (
  <section class="fakty">
    {d.fakty.map((f) => (
      <article class="fakt" data-fakt>
        {f.znachok && <span class="ms fakt__znachok">{f.znachok}</span>}
        <div class="fakt__zagolovok">{f.zagolovok ?? f.nazvanie}</div>
        <div class="fakt__podpis">{f.podpis ?? f.znachenie}</div>
      </article>
    ))}
  </section>
)}

{d.sekcii.map((s) => (
  <section class="sekciya" data-sekciya>
    {s.zagolovok && <h2 class="sekciya__zagolovok">{s.zagolovok}</h2>}

    {s.tip === 'kartochki' && (
      <div class="sekciya__kartochki">
        {s.elementy.map((e) => (
          <article class="reshenie">
            <a class="reshenie__telo" href={e.vedyot_na ? put(`/catalog/${e.vedyot_na}/`) : zayavka}>
              {e.kartinka && (
                <div class="reshenie__kartinka">
                  <img src={put(e.kartinka)} alt={e.nazvanie} loading="lazy" />
                </div>
              )}
              <h3 class="reshenie__nazvanie">{e.nazvanie}</h3>
              {e.opisanie && <p class="reshenie__opisanie">{e.opisanie}</p>}
            </a>
          </article>
        ))}
      </div>
    )}

    {s.tip === 'bloki' && (
      <div class="sekciya__bloki">
        {s.elementy.map((e) => (
          <article class="blok">
            {e.znachok && <span class="ms blok__znachok">{e.znachok}</span>}
            <h3 class="blok__zagolovok">{e.zagolovok}</h3>
            {e.podpis && <p class="blok__podpis">{e.podpis}</p>}
          </article>
        ))}
      </div>
    )}

    {s.tip === 'harakteristiki' && (
      <dl class="harakteristiki">
        {s.elementy.map((e) => (
          <div class="harakteristika">
            <dt class="harakteristika__nazvanie">
              {e.znachok && <span class="ms">{e.znachok}</span>}{e.nazvanie}
            </dt>
            <dd class="harakteristika__znachenie">{e.znachenie}</dd>
          </div>
        ))}
      </dl>
    )}

    {s.tip === 'tablica' && (
      <div class="sekciya__kartochki">
        {s.elementy.map((e) => (
          <article class="reshenie">
            <div class="reshenie__telo">
              {e.kartinka && (
                <div class="reshenie__kartinka">
                  <img src={put(e.kartinka)} alt={e.nazvanie} loading="lazy" />
                </div>
              )}
              <h3 class="reshenie__nazvanie">{e.nazvanie}</h3>
              {e.harakteristika && <p class="reshenie__opisanie">{e.harakteristika}</p>}
              <div class="reshenie__metki">
                {e.metka1 && <span class="metka">{e.metka1}</span>}
                {e.metka2 && <span class="metka">{e.metka2}</span>}
              </div>
            </div>
          </article>
        ))}
      </div>
    )}
  </section>
))}

{d.galereya?.length > 0 && (
  <section class="sekciya">
    <div class="galereya-tovara">
      {d.galereya.map((g) => <img src={put(g)} alt={d.zagolovok} loading="lazy" />)}
    </div>
  </section>
)}

{d.podbor && (
  <section class="podbor" data-podbor>
    <h2 class="podbor__zagolovok">{d.podbor.zagolovok}</h2>

    {d.podbor.tip === 'vybor' ? (
      <form class="podbor__forma" data-forma-podbora>
        {d.podbor.parametry.map((p, i) => (
          <label class="podbor__pole">
            <span class="podbor__podpis">{p.podpis}</span>
            <select name={`param-${i}`} data-parametr={p.podpis}>
              <option value="">Не выбрано</option>
              {p.varianty.map((v) => <option value={v}>{v}</option>)}
            </select>
          </label>
        ))}
        <button type="button" class="podbor__knopka" data-otpravit data-pochta={sayt.pochta} data-tema={`Подбор: ${d.zagolovok}`}>
          Отправить запрос <span class="ms">arrow_forward</span>
        </button>
      </form>
    ) : (
      <div class="podbor__spisok">
        {d.podbor.parametry.map((p) => (
          <div class="podbor__parametr">
            {p.znachok && <span class="ms">{p.znachok}</span>}{p.podpis}
          </div>
        ))}
        <a class="podbor__knopka" href={zayavka}>Отправить запрос <span class="ms">arrow_forward</span></a>
      </div>
    )}
  </section>
)}

<style>
  .tovar-verh {
    display: grid;
    grid-template-columns: 45% 1fr;
    gap: 16px;
    padding: 16px var(--pole-bok) 0;
  }

  .tovar-verh__tekst {
    padding: 40px 38px 42px;
    background: var(--fon-gero);
    border-radius: var(--radius-karta);
    display: flex;
    flex-direction: column;
    justify-content: center;
  }

  .tovar-verh__zagolovok {
    margin: 0;
    font-size: clamp(28px, 3.4vw, 52px);
    line-height: 1.03;
    letter-spacing: -.03em;
    font-weight: 700;
    overflow-wrap: anywhere;
  }

  .tovar-verh__lead { margin: 18px 0 0; font-size: 17px; line-height: 1.55; color: var(--tekst-vtoroy); }

  .tovar-verh__knopka {
    align-self: flex-start;
    margin-top: 26px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    background: var(--tekst);
    color: #fff;
    border-radius: var(--radius-pilyulya);
    padding: 14px 26px;
    font-size: 16px;
  }

  .tovar-verh__knopka:hover { color: #fff; opacity: .9; }
  .tovar-verh__kartinka { border-radius: var(--radius-karta); overflow: hidden; background: #DCE3DF; min-height: 340px; }
  .tovar-verh__kartinka img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .fakty { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; padding: 16px var(--pole-bok) 0; }
  .fakt { background: #F6F8F7; border-radius: var(--radius-karta); padding: 22px 24px 24px; }
  .fakt__znachok { font-size: 26px; color: var(--akcent); }
  .fakt__zagolovok { margin-top: 12px; font-size: 19px; font-weight: 700; line-height: 1.2; }
  .fakt__podpis { margin-top: 6px; font-size: 14px; line-height: 1.45; color: var(--tekst-vtoroy); }

  .sekciya { padding: 34px var(--pole-bok) 0; }
  .sekciya__zagolovok { margin: 0 0 20px; font-size: 30px; font-weight: 700; letter-spacing: -.02em; }

  .sekciya__kartochki { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }
  .sekciya__bloki { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }

  .reshenie__telo {
    display: flex;
    flex-direction: column;
    gap: 10px;
    background: #fff;
    border-radius: 24px;
    padding: 10px;
    box-shadow: 0 6px 22px rgba(16, 18, 20, .06);
    height: 100%;
  }

  a.reshenie__telo:hover { transform: translateY(-3px); box-shadow: 0 12px 30px rgba(16, 18, 20, .12); }
  .reshenie__telo { transition: transform .25s, box-shadow .25s; }
  .reshenie__kartinka { border-radius: 18px; overflow: hidden; background: #DCE3DF; height: 152px; }
  .reshenie__kartinka img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .reshenie__nazvanie { margin: 4px 6px 0; font-size: 16px; font-weight: 600; line-height: 1.25; }
  .reshenie__opisanie { margin: 0 6px 10px; font-size: 13px; line-height: 1.45; color: var(--tekst-tihiy); }
  .reshenie__metki { display: flex; flex-wrap: wrap; gap: 6px; margin: 0 6px 10px; }

  .metka { background: #EFF3F0; border-radius: var(--radius-pilyulya); padding: 4px 10px; font-size: 12px; color: var(--tekst-vtoroy); }

  .blok { background: #F6F8F7; border-radius: var(--radius-karta); padding: 24px 24px 26px; }
  .blok__znachok { font-size: 28px; color: var(--akcent); }
  .blok__zagolovok { margin: 12px 0 0; font-size: 17px; font-weight: 600; line-height: 1.3; }
  .blok__podpis { margin: 8px 0 0; font-size: 14px; line-height: 1.5; color: var(--tekst-vtoroy); }

  .harakteristiki { margin: 0; background: #fff; border-radius: var(--radius-karta); padding: 8px 24px; }
  .harakteristika { display: flex; justify-content: space-between; gap: 20px; padding: 16px 0; border-bottom: 1px solid #EFF3F0; }
  .harakteristika:last-child { border-bottom: 0; }
  .harakteristika__nazvanie { display: flex; align-items: center; gap: 10px; margin: 0; font-size: 15px; color: var(--tekst-vtoroy); }
  .harakteristika__nazvanie .ms { font-size: 20px; color: var(--akcent); }
  .harakteristika__znachenie { margin: 0; font-size: 15px; font-weight: 600; text-align: right; }

  .galereya-tovara { display: grid; grid-template-columns: repeat(4, 1fr); gap: 15px; }
  .galereya-tovara img { width: 100%; border-radius: var(--radius-karta); display: block; }

  .podbor { padding: 34px var(--pole-bok) 44px; }
  .podbor__zagolovok { margin: 0 0 20px; font-size: 30px; font-weight: 700; letter-spacing: -.02em; }

  .podbor__forma, .podbor__spisok {
    background: #F6F8F7;
    border-radius: var(--radius-karta);
    padding: 26px 28px 28px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 16px;
    align-items: end;
  }

  .podbor__pole { display: flex; flex-direction: column; gap: 8px; }
  .podbor__podpis { font-size: 14px; color: var(--tekst-vtoroy); }

  .podbor__pole select {
    border: 1px solid #E4E9E6;
    border-radius: 12px;
    padding: 13px 14px;
    font-size: 15px;
    font-family: inherit;
    background: #fff;
    color: var(--tekst);
  }

  .podbor__parametr { display: flex; align-items: center; gap: 10px; font-size: 15px; color: var(--tekst-vtoroy); }
  .podbor__parametr .ms { font-size: 20px; color: var(--akcent); }

  .podbor__knopka {
    grid-column: 1 / -1;
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 0;
    background: var(--akcent);
    color: #fff;
    border-radius: var(--radius-pilyulya);
    padding: 14px 26px;
    font-size: 16px;
    font-family: inherit;
    cursor: pointer;
  }

  .podbor__knopka:hover { color: #fff; opacity: .9; }

  @media (max-width: 1280px) {
    .fakty, .sekciya__kartochki, .sekciya__bloki, .galereya-tovara { grid-template-columns: repeat(3, 1fr); }
  }

  @media (max-width: 1024px) {
    .tovar-verh { grid-template-columns: 1fr; }
    .tovar-verh__kartinka { min-height: 260px; }
  }

  @media (max-width: 768px) {
    .fakty, .sekciya__kartochki, .sekciya__bloki, .galereya-tovara { grid-template-columns: repeat(2, 1fr); }
    .podbor__forma, .podbor__spisok { grid-template-columns: 1fr; }
    .sekciya__zagolovok, .podbor__zagolovok { font-size: 24px; }
    .tovar-verh__tekst { padding: 28px 22px 30px; }
    .harakteristika { flex-direction: column; gap: 4px; }
    .harakteristika__znachenie { text-align: left; }
  }

  @media (max-width: 480px) {
    .fakty, .sekciya__kartochki, .sekciya__bloki, .galereya-tovara { grid-template-columns: 1fr; }
  }
</style>

<script>
  document.querySelectorAll('[data-otpravit]').forEach((knopka) => {
    knopka.addEventListener('click', () => {
      const forma = knopka.closest('[data-forma-podbora]');
      const stroki = [];
      forma?.querySelectorAll('select').forEach((pole) => {
        if (pole.value) stroki.push(`${pole.dataset.parametr}: ${pole.value}`);
      });
      const telo = stroki.length
        ? `Прошу подобрать решение по параметрам:\n\n${stroki.join('\n')}`
        : 'Прошу помочь с подбором решения.';
      const adres = `mailto:${knopka.dataset.pochta}?subject=${encodeURIComponent(knopka.dataset.tema)}&body=${encodeURIComponent(telo)}`;
      window.location.href = adres;
    });
  });
</script>
