---
import { put } from '../lib/put.js';
import { kategorii } from '../lib/content.js';
---

<nav class="mobmenyu" id="mobilnoe-menyu" hidden aria-label="Каталог">
  <div class="mobmenyu__zagolovok">Каталог</div>
  <ul class="mobmenyu__spisok">
    {kategorii.map((k) => (
      <li>
        <a href={put(`/catalog/${k.klyuch}/`)}>{k.korotko}</a>
      </li>
    ))}
  </ul>
</nav>

<style>
  .mobmenyu {
    position: absolute;
    left: 0;
    right: 0;
    top: 100%;
    z-index: 30;
    background: var(--fon-shapka);
    padding: 20px var(--pole-bok) 32px;
    box-shadow: 0 18px 40px rgba(16, 18, 20, .12);
    max-height: calc(100vh - 102px);
    overflow-y: auto;
  }

  .mobmenyu[hidden] { display: none; }

  /* на широком экране работает обычная навигация: панель не должна висеть поверх страницы */
  @media (min-width: 1025px) { .mobmenyu { display: none; } }

  .mobmenyu__zagolovok {
    font-size: 12.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--tekst-tihiy);
    margin-bottom: 14px;
  }

  .mobmenyu__spisok { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }

  .mobmenyu__spisok a {
    display: block;
    padding: 13px 0;
    font-size: 17px;
    border-bottom: 1px solid rgba(16, 18, 20, .08);
  }
</style>

<script>
  const burger = document.querySelector('[data-burger]');
  const menyu = document.getElementById('mobilnoe-menyu');

  const pereklyuchit = (otkryt) => {
    if (!burger || !menyu) return;
    burger.setAttribute('aria-expanded', String(otkryt));
    menyu.hidden = !otkryt;
    // блокировать прокрутку нужно на корневом элементе: у body это не сработает,
    // потому что overflow-x задан на html и значения берутся оттуда
    document.documentElement.style.overflow = otkryt ? 'hidden' : '';
  };

  burger?.addEventListener('click', () => {
    pereklyuchit(burger.getAttribute('aria-expanded') !== 'true');
  });

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && burger?.getAttribute('aria-expanded') === 'true') pereklyuchit(false);
  });

  // поворот планшета в горизонт возвращает обычную навигацию — панель закрываем
  window.matchMedia('(min-width: 1025px)').addEventListener('change', (e) => {
    if (e.matches && burger?.getAttribute('aria-expanded') === 'true') pereklyuchit(false);
  });
</script>
