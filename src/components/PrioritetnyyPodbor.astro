---
import { sayt } from '../lib/content.js';

interface Props {
  podbor: any;
  zagolovok: string;
}

const { podbor, zagolovok } = Astro.props;
---

<section class="prioritetnyy-podbor" id="podbor" data-podbor data-podbor-prioritet aria-labelledby="podbor-zagolovok">
  <div class="prioritetnyy-podbor__verh">
    <div>
      <div class="prioritetnyy-podbor__metka">Основной шаг для заказа</div>
      <h2 class="prioritetnyy-podbor__zagolovok" id="podbor-zagolovok">{podbor.zagolovok}</h2>
    </div>
    {podbor.opisanie && <p class="prioritetnyy-podbor__opisanie">{podbor.opisanie}</p>}
  </div>

  <form class="prioritetnyy-podbor__forma" data-forma-podbora onsubmit="return false">
    {podbor.parametry.map((p, i) => (
      <label class="prioritetnyy-podbor__pole">
        <span class="prioritetnyy-podbor__podpis">{p.podpis}</span>
        {p.mnogostrochnyy
          ? <textarea name={`param-${i}`} data-parametr={p.podpis} rows="3" placeholder={p.podskazka}></textarea>
          : <input type="text" name={`param-${i}`} data-parametr={p.podpis} placeholder={p.podskazka} />}
      </label>
    ))}
    <div class="prioritetnyy-podbor__deystviya">
      <p class="prioritetnyy-podbor__primechanie">Заполните только известные параметры. Кнопка подготовит письмо в вашей почтовой программе.</p>
      <button type="button" class="prioritetnyy-podbor__knopka" data-otpravit data-pochta={sayt.pochta} data-tema={`Подбор: ${zagolovok}`}>
        Подготовить запрос <span class="ms">arrow_forward</span>
      </button>
    </div>
  </form>
</section>

<style>
  .prioritetnyy-podbor {
    margin: 16px var(--pole-bok) 0;
    padding: 24px 28px 28px;
    border: 1px solid rgba(50, 45, 42, .22);
    border-radius: var(--radius-karta);
    background: #fff;
    box-shadow: 0 18px 42px rgba(50, 45, 42, .08);
    scroll-margin-top: 24px;
  }

  .prioritetnyy-podbor__verh {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(280px, .85fr);
    gap: 28px;
    align-items: end;
    margin-bottom: 20px;
  }

  .prioritetnyy-podbor__metka {
    display: inline-flex;
    width: fit-content;
    margin-bottom: 10px;
    padding: 6px 11px;
    border-radius: var(--radius-pilyulya);
    font-size: 11px;
    line-height: 1.3;
    letter-spacing: .08em;
    text-transform: uppercase;
    color: #fff;
    background: var(--tekst);
  }

  .prioritetnyy-podbor__zagolovok {
    margin: 0;
    font-size: clamp(24px, 2.2vw, 34px);
    line-height: 1.15;
    font-weight: 400;
  }

  .prioritetnyy-podbor__opisanie,
  .prioritetnyy-podbor__primechanie {
    margin: 0;
    font-size: 14px;
    line-height: 1.5;
    color: var(--tekst-vtoroy);
  }

  .prioritetnyy-podbor__forma {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 14px;
    align-items: end;
  }

  .prioritetnyy-podbor__pole {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 7px;
  }

  .prioritetnyy-podbor__podpis {
    font-size: 13px;
    line-height: 1.35;
    color: var(--tekst-vtoroy);
  }

  .prioritetnyy-podbor__pole input,
  .prioritetnyy-podbor__pole textarea {
    width: 100%;
    min-width: 0;
    box-sizing: border-box;
    padding: 12px 16px;
    border: 1px solid #dedad1;
    border-radius: 16px;
    font: inherit;
    color: var(--tekst);
    background: var(--fon);
  }

  .prioritetnyy-podbor__pole textarea { resize: vertical; }

  .prioritetnyy-podbor__deystviya {
    grid-column: span 2;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
  }

  .prioritetnyy-podbor__primechanie { max-width: 48ch; }

  .prioritetnyy-podbor__knopka {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    border: 0;
    border-radius: var(--radius-pilyulya);
    padding: 13px 22px;
    font: inherit;
    color: #fff;
    background: var(--tekst);
    cursor: pointer;
  }

  .prioritetnyy-podbor__knopka:hover { opacity: .9; }

  @media (max-width: 1024px) {
    .prioritetnyy-podbor__verh { grid-template-columns: 1fr; gap: 10px; }
    .prioritetnyy-podbor__forma { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .prioritetnyy-podbor__deystviya { grid-column: 1 / -1; }
  }

  @media (max-width: 768px) {
    .prioritetnyy-podbor { padding: 22px; }
    .prioritetnyy-podbor__forma { grid-template-columns: 1fr; }
    .prioritetnyy-podbor__deystviya { flex-direction: column; align-items: stretch; }
    .prioritetnyy-podbor__knopka { justify-content: center; }
  }
</style>
