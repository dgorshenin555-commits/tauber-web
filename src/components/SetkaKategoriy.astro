---
import { kategorii } from '../lib/content.js';
import KartochkaKategorii from './KartochkaKategorii.astro';
---

<section class="setka">
  <div class="setka__shapka">
    <div>
      <h2 class="setka__zagolovok">Основные категории</h2>
      <p class="setka__podzagolovok">Оборудование и решения для промышленных и энергетических объектов</p>
    </div>
  </div>

  <div class="setka__kartochki">
    {kategorii.map((k) => <KartochkaKategorii kategoriya={k} />)}
  </div>
</section>

<style>
  .setka { background: var(--fon); padding: 34px var(--pole-bok) 30px; }
  .setka__shapka { display: flex; align-items: baseline; justify-content: space-between; margin-bottom: 22px; }
  .setka__zagolovok { margin: 0; font-size: 33px; font-weight: 700; letter-spacing: -.02em; }
  .setka__podzagolovok { margin: 8px 0 0; font-size: 15px; color: var(--tekst-vtoroy); }
  .setka__kartochki { display: grid; grid-template-columns: repeat(5, 1fr); gap: 15px; }

  @media (max-width: 1280px) { .setka__kartochki { grid-template-columns: repeat(4, 1fr); } }
  @media (max-width: 1024px) { .setka__kartochki { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 768px) {
    .setka__kartochki { grid-template-columns: repeat(2, 1fr); }
    .setka__zagolovok { font-size: 26px; }
  }
  @media (max-width: 480px) { .setka__kartochki { grid-template-columns: repeat(1, 1fr); } }
</style>
