---
import { put } from '../lib/put.js';
import { fotoProizvodstva } from '../lib/content.js';
---

<div class="galereya" data-galereya>
  {fotoProizvodstva.map((f, i) => (
    <div class="galereya__kadr" data-kadr style={`opacity:${i === 0 ? 1 : 0}`}>
      <img src={put(f.fayl)} alt={f.podpis} loading={i === 0 ? 'eager' : 'lazy'} />
    </div>
  ))}

  <div class="galereya__niz">
    <span class="galereya__podpis" data-podpis>{fotoProizvodstva[0].podpis}</span>
    <div class="galereya__upravlenie">
      <div class="galereya__tochki">
        {fotoProizvodstva.map((f, i) => (
          <button
            type="button"
            class="galereya__tochka"
            data-tochka
            aria-label={`Показать фотографию: ${f.podpis}`}
            aria-current={i === 0 ? 'true' : 'false'}
          ><span class="galereya__tochka-vid"></span></button>
        ))}
      </div>

      <button type="button" class="galereya__strelka" data-galereya-nazad aria-label="Предыдущая фотография">
        <span class="ms">arrow_back</span>
      </button>
      <button type="button" class="galereya__strelka galereya__strelka--akcent" data-galereya-vpered aria-label="Следующая фотография">
        <span class="ms">arrow_forward</span>
      </button>
    </div>
  </div>
</div>

<style>
  .galereya {
    position: relative;
    background: #77716b;
    border-radius: var(--radius-karta);
    overflow: hidden;
    min-height: 360px;
  }

  .galereya__kadr {
    position: absolute;
    inset: 0;
    transition: opacity .6s;
  }

  .galereya__kadr img { width: 100%; height: 100%; object-fit: cover; display: block; }

  .galereya__niz {
    position: absolute;
    left: 18px;
    right: 18px;
    bottom: 18px;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 14px;
  }

  .galereya__podpis {
    display: inline-flex;
    align-items: center;
    background: rgba(16, 18, 20, .55);
    color: #fff;
    border-radius: var(--radius-pilyulya);
    padding: 7px 14px;
    font-size: 13px;
    backdrop-filter: blur(6px);
  }

  .galereya__upravlenie { display: flex; align-items: center; gap: 8px; }

  .galereya__tochki {
    display: flex;
    align-items: center;
    gap: 2px;
    background: rgba(16, 18, 20, .55);
    border-radius: var(--radius-pilyulya);
    padding: 0 4px;
    backdrop-filter: blur(6px);
  }

  /* сама точка остаётся 8px, но кнопка вокруг неё — 24px, иначе в неё не попасть пальцем */
  .galereya__tochka {
    min-width: 24px;
    min-height: 24px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: 0;
    background: none;
    cursor: pointer;
  }

  .galereya__tochka-vid {
    display: block;
    width: 8px;
    height: 8px;
    border-radius: var(--radius-pilyulya);
    background: rgba(255, 255, 255, .7);
    transition: width .3s, background .3s;
  }

  .galereya__tochka[aria-current='true'] .galereya__tochka-vid { width: 22px; background: var(--akcent); }

  .galereya__strelka {
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 0;
    border-radius: 50%;
    background: rgba(255, 255, 255, .92);
    color: var(--tekst);
    cursor: pointer;
  }

  .galereya__strelka--akcent { background: var(--akcent); color: #fff; }
  .galereya__strelka .ms { font-size: 20px; }

  @media (max-width: 1024px) { .galereya { min-height: 300px; } }
  @media (max-width: 768px) { .galereya { min-height: 240px; } }
  @media (max-width: 480px) {
    .galereya { min-height: 200px; }
    .galereya__podpis { font-size: 12px; padding: 6px 11px; }
  }

  .galereya { min-height: 430px; background: var(--fon-gero); }
  .galereya__podpis { color: var(--tekst); background: rgba(255,255,255,.94); backdrop-filter: none; }
  .galereya__tochka[aria-current='true'] .galereya__tochka-vid { background: #fff; }
  .galereya__strelka--akcent { background: var(--fon); color: var(--tekst); }
  .galereya__niz { flex-wrap: wrap; gap: 8px; }
  @media (max-width: 768px) { .galereya { min-height: 340px; } }
  @media (max-width: 480px) { .galereya { min-height: 300px; } .galereya__tochki { display: none; } }

</style>

<script>
  const galereya = document.querySelector('[data-galereya]');

  if (galereya) {
    const kadry = [...galereya.querySelectorAll('[data-kadr]')];
    const tochki = [...galereya.querySelectorAll('[data-tochka]')];
    const podpis = galereya.querySelector('[data-podpis]');
    let tekushchiy = 0;
    let taymer = null;
    let navedenie = false;
    let fokus = false;
    const spokoyno = window.matchMedia('(prefers-reduced-motion: reduce)');

    const pokazat = (i) => {
      tekushchiy = (i + kadry.length) % kadry.length;
      kadry.forEach((k, n) => { k.style.opacity = n === tekushchiy ? '1' : '0'; });
      tochki.forEach((t, n) => t.setAttribute('aria-current', String(n === tekushchiy)));
      const img = kadry[tekushchiy].querySelector('img');
      if (podpis && img) podpis.textContent = img.getAttribute('alt') ?? '';
    };

    const stop = () => { if (taymer) { clearInterval(taymer); taymer = null; } };
    const pusk = () => { stop(); if (!spokoyno.matches && !document.hidden && !navedenie && !fokus) taymer = setInterval(() => pokazat(tekushchiy + 1), 5000); };

    tochki.forEach((t, n) => t.addEventListener('click', () => { pokazat(n); pusk(); }));

    galereya.querySelector('[data-galereya-nazad]')
      ?.addEventListener('click', () => { pokazat(tekushchiy - 1); pusk(); });
    galereya.querySelector('[data-galereya-vpered]')
      ?.addEventListener('click', () => { pokazat(tekushchiy + 1); pusk(); });

    // человек читает подпись — не подменяем кадр под ним
    galereya.addEventListener('mouseenter', () => { navedenie = true; stop(); });
    galereya.addEventListener('mouseleave', () => { navedenie = false; pusk(); });
    galereya.addEventListener('focusin', () => { fokus = true; stop(); });
    galereya.addEventListener('focusout', (e) => { fokus = !!e?.relatedTarget && galereya.contains(e.relatedTarget); pusk(); });

    document.addEventListener('visibilitychange', () => (document.hidden ? stop() : pusk()));
    window.addEventListener('pagehide', stop);

    // при системной настройке «уменьшить движение» кадры не листаются сами
    pusk();
    spokoyno.addEventListener('change', (e) => (e.matches ? stop() : pusk()));
  }
</script>
