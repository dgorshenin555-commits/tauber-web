---
import { sayt, futer } from '../lib/content.js';

const telefonSsylka = `tel:${sayt.telefon.replace(/[^\d+]/g, '')}`;
const zayavkaSsylka = `mailto:${sayt.pochta}?subject=${encodeURIComponent('Заявка с сайта')}`;
---

<aside class="zadacha" data-panel-zadacha>
  <div class="zadacha__nadzagolovok">Есть задача?</div>
  <div class="zadacha__zagolovok">Обсудим ваш проект</div>
  <p class="zadacha__tekst">
    Инженер профильного направления свяжется с вами, уточнит параметры объекта и подготовит техническое и коммерческое предложение.
  </p>

  <div class="zadacha__kontakty">
    <a class="zadacha__kontakt" href={telefonSsylka}><span class="ms">call</span>{sayt.telefon}</a>
    <a class="zadacha__kontakt" href={`mailto:${sayt.pochta}`}><span class="ms">mail</span>{sayt.pochta}</a>
  </div>

  <a class="zadacha__knopka" href={zayavkaSsylka}>
    {futer.knopka_zayavki} <span class="ms">arrow_forward</span>
  </a>
</aside>

<style>
  .zadacha {
    background: var(--temnaya);
    color: #fff;
    border-radius: var(--radius-karta);
    padding: 30px 32px 32px;
    display: flex;
    flex-direction: column;
  }

  .zadacha__nadzagolovok {
    font-size: 12.5px;
    letter-spacing: .1em;
    text-transform: uppercase;
    color: var(--akcent);
  }

  .zadacha__zagolovok {
    margin-top: 14px;
    font-size: 32px;
    line-height: 1.05;
    font-weight: 300;
    letter-spacing: .005em;
  }

  .zadacha__tekst { margin: 14px 0 0; font-size: 15px; line-height: 1.55; color: #c9c5bd; }

  .zadacha__kontakty { margin-top: 22px; display: flex; flex-direction: column; gap: 10px; }

  .zadacha__kontakt { display: inline-flex; align-items: center; gap: 9px; color: #fff; font-size: 17px; }
  .zadacha__kontakt:hover { color: var(--akcent); }
  .zadacha__kontakt .ms { font-size: 20px; color: var(--akcent); }

  .zadacha__knopka {
    margin-top: auto;
    padding-top: 26px;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    color: #fff;
    font-size: 15px;
  }

  .zadacha__knopka:hover { color: var(--akcent); }

  .zadacha { padding: 28px 30px; }
  .zadacha__nadzagolovok, .zadacha__kontakt .ms { color: #fff; }
  .zadacha__zagolovok { font-size: 33px; }
  .zadacha__tekst { color: #c9c5bd; }
  .zadacha__knopka { background: var(--fon); color: var(--tekst); border-radius: 999px; padding: 16px 24px; margin-top: 28px; justify-content: space-between; }
  .zadacha__kontakt:hover { color: #c9c5bd; }
  .zadacha__knopka:hover { background: #fff; color: var(--tekst); }

</style>
